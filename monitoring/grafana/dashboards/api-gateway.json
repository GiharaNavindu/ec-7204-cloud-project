{
  "title": "API Gateway Overview",
  "panels": [
    {
      "title": "Gateway Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"api-gateway\"}[1m]))"
        }
      ]
    },
    {
      "title": "Gateway 5xx Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"api-gateway\",status=~\"5..\"}[1m]))"
        }
      ]
    },
    {
      "title": "Gateway 429 Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"api-gateway\",status=\"429\"}[1m]))"
        }
      ]
    }
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s"
}
