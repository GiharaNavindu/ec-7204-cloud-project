# Copy to .env and set strong values before running docker compose....
# Use at least 64 random characters for HS512 JWT signing.
JWT_SECRET=replace_with_a_minimum_64_characters_random_secret_for_jwt_signing
JWT_EXPIRATION=86400000

# ===== Google OAuth2 Credentials (SSO) =====
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== Grafana Admin Credentials (change for shared/prod-like environments) =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ===== Service URLs used by API Gateway =====
USER_SERVICE_URL=http://user-service:8081
AUCTION_SERVICE_URL=http://auction-service:8082
BID_SERVICE_URL=http://bid-service:8083
PAYMENT_SERVICE_URL=http://payment-service:8084
NOTIFICATION_SERVICE_URL=http://notification-service:8085

